@startuml
hide methods
skinparam linetype ortho
entity "users" as users {
  * id : varchar <<PK>>
  --
  username : varchar <<UQ>>
  hashed_password : varchar
  name : varchar
  phone : varchar
  email : varchar
  balance : numeric(18,2)
}
entity "tuitions" as tuitions {
  * id : integer <<PK>>
  --
  student_code : varchar <<UQ>>
  student_name : varchar
  tuition_fee : numeric(18,2)
  is_paid : boolean
  paid_at : timestamp
  paid_transaction_id : varchar <<UQ>>
}
entity "transactions" as transactions {
  * id : varchar <<PK>>
  --
  mssv : varchar
  student_name : varchar
  amount : numeric(18,2)
  user_id : varchar
  user_email : varchar
  otp_hash : varchar
  otp_expires_at : timestamp
  otp_attempts : integer
  status : varchar
  created_at : timestamp
  processed_at : timestamp
}
entity "wallet_operations" as wallet_ops {
  * id : integer <<PK>>
  --
  transaction_id : varchar
  operation : varchar
  user_id : varchar
  amount : numeric(18,2)
  created_at : timestamp
  --
  UQ(transaction_id, operation)
}
users ||..o{ wallet_ops : logical user_id
users ||..o{ transactions : logical user_id
transactions }o..|| tuitions : mssv / paid_transaction_id
note bottom of transactions
  Logical references across services.
  Phase 2 should use service-owned databases;
  do not add cross-service foreign keys.
end note
@enduml
