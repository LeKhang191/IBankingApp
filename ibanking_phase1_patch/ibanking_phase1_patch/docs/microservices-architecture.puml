@startuml
left to right direction
actor "Student" as student
rectangle "Browser" {
  component "React Frontend\n:5173" as FE
}
node "Docker Network" {
  component "API Gateway\n(Phase 2 target)" as GW #line.dashed
  component "Auth Service\nFastAPI :8001" as AUTH
  component "Tuition Service\nFastAPI :8001" as TUITION
  component "Payment Service\nFastAPI :8001" as PAYMENT
  component "Notification Service\nFastAPI :8003" as NOTIFY
  database "PostgreSQL\n(Phase 1 shared DB)" as DB
}
cloud "SMTP Provider" as SMTP
student --> FE
FE --> AUTH : REST/JWT
FE --> TUITION : REST
FE --> PAYMENT : REST/JWT
PAYMENT --> AUTH : REST/JWT\nwallet debit/refund
PAYMENT --> TUITION : REST + internal token\nsettlement
PAYMENT --> NOTIFY : REST + internal token\nOTP/receipt
NOTIFY --> SMTP : SMTP/TLS
AUTH --> DB
TUITION --> DB
PAYMENT --> DB
GW .. FE : Future single entry point
note bottom of DB
  Phase 1 shares one PostgreSQL database.
  Phase 2 target: auth_db, tuition_db,
  payment_db with explicit data ownership.
end note
@enduml
