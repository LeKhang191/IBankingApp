@startuml
 title iBanking - Microservices Architecture (Phase 2)
 left to right direction
 skinparam componentStyle rectangle

 actor "Sinh viên" as Student

 package "Client" {
   [React Frontend] as FE
 }

 package "Backend Microservices" {
   component "Auth Service\nFastAPI :8001" as Auth
   component "Tuition Service\nFastAPI :8001" as Tuition
   component "Payment Service\nFastAPI :8001" as Payment
   component "Notification Service\nFastAPI :8003" as Notify
 }

 database "auth_db\nOwner: auth_user" as AuthDB
 database "tuition_db\nOwner: tuition_user" as TuitionDB
 database "payment_db\nOwner: payment_user" as PaymentDB
 cloud "SMTP Provider" as SMTP

 Student --> FE
 FE --> Auth : Login / profile\nHTTP REST
 FE --> Tuition : Tuition lookup\nHTTP REST
 FE --> Payment : Init / OTP / history\nHTTP REST
 Payment --> Auth : Verify user, debit, refund\nHTTP + internal token
 Payment --> Tuition : Read tuition, settle\nHTTP + internal token
 Payment --> Notify : OTP / receipt\nHTTP + internal token
 Auth --> AuthDB : SQLAlchemy
 Tuition --> TuitionDB : SQLAlchemy
 Payment --> PaymentDB : SQLAlchemy
 Notify --> SMTP : SMTP / TLS

 note bottom of AuthDB
   Owned and accessed by Auth Service only.
 end note
 note bottom of TuitionDB
   Owned and accessed by Tuition Service only.
 end note
 note bottom of PaymentDB
   Owned and accessed by Payment Service only.
 end note
@enduml
