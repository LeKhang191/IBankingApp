# PostgreSQL server / legacy Phase 1 database.
# When reusing an existing pgdata volume, keep POSTGRES_USER, POSTGRES_PASSWORD
# and POSTGRES_DB consistent with the initialized PostgreSQL cluster.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# The original Compose deployment initializes the cluster as this user.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_existing_or_new_random_password
# The original Compose deployment uses the legacy DB name ibanking.
POSTGRES_DB=ibanking

# Phase 2: one login role and one database per data-owning microservice.
# Use URL-safe hexadecimal passwords (for example, 64 hex characters).
AUTH_DB_NAME=auth_db
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=replace_with_unique_hex_secret

TUITION_DB_NAME=tuition_db
TUITION_DB_USER=tuition_user
TUITION_DB_PASSWORD=replace_with_different_unique_hex_secret

PAYMENT_DB_NAME=payment_db
PAYMENT_DB_USER=payment_user
PAYMENT_DB_PASSWORD=replace_with_another_unique_hex_secret

# Set false only for the first Phase 2 startup when migrating old data.
# After migration, this may be set back to true; existing data will not be overwritten.
SEED_DEMO_DATA=true

# Authentication and internal service security.
JWT_SECRET_KEY=replace_with_at_least_32_random_bytes
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
INTERNAL_SERVICE_TOKEN=replace_with_a_different_long_random_secret

# OTP configuration.
OTP_PEPPER=replace_with_another_different_long_random_secret
OTP_LENGTH=6
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_MAX_RESENDS=3
OTP_RESEND_COOLDOWN_SECONDS=30

# Browser access.
CORS_ALLOW_ORIGINS=http://localhost:5173
VITE_API_URL=http://localhost:8000
VITE_TUITION_API_URL=http://localhost:8002
VITE_PAYMENT_API_URL=http://localhost:8003

# SMTP.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_google_app_password
EMAIL_FROM=iBanking <your_email@gmail.com>

# Phase 3: recoverable Saga + transactional outbox worker.
SAGA_LEASE_SECONDS=90
SAGA_RETRY_SECONDS=10
OUTBOX_POLL_SECONDS=3
OUTBOX_LEASE_SECONDS=60
LOG_LEVEL=INFO
